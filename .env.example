# Copy to .env and fill in. Never commit .env. On the VPS the same file lives at /opt/bymachines-lab/.env (without the hosting token).
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Hosting (operator's machine only, for deploy/provision_do.py)
DIGITALOCEAN_TOKEN=

# Runtime (optional). Budget, run hour and every other tunable live in config/engines.yaml.
LAB_DATA_DIR=data
